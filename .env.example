# URL of the deployed backend (Fly.io), e.g. https://youtube-mp3-backend.fly.dev
BACKEND_URL=

# Must match API_SECRET set on the backend
BACKEND_API_SECRET=

# Optional: powers the bouncing album-art strip at the bottom of the page,
# pulled from your Last.fm top artists. Get a free key at
# https://www.last.fm/api/account/create - no OAuth needed, read-only.
# Leave blank to disable the feature entirely.
LASTFM_API_KEY=
LASTFM_USERNAME=
