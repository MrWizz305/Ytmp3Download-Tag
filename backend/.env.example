# Shared secret the frontend must send as the x-api-key header.
# Generate one with: openssl rand -hex 32
API_SECRET=

# Optional: base64-encoded Netscape-format cookies.txt exported from a logged-in
# YouTube session in your own browser. Significantly reduces "Sign in to confirm
# you're not a bot" failures. See README.md for how to export and encode it.
YTDLP_COOKIES_B64=

# Optional: reject videos longer than this many seconds (default 1800 = 30 min).
MAX_DURATION_SECONDS=1800

PORT=8080
